rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.role is string && (data.role == 'student' || data.role == 'researcher')
        && data.keys().hasAll(['uid', 'email', 'role'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'collegeName', 'role', 'createdAt']);
    }

    // Scan Record Validation
    function isValidScanRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.breedName is string && data.breedName.size() <= 128
        && data.category is string && (data.category == 'Cattle' || data.category == 'Buffalo')
        && data.confidence is number && data.confidence >= 0 && data.confidence <= 100
        && data.timestamp is number
        && data.keys().hasAll(['id', 'userId', 'breedName', 'category', 'confidence', 'timestamp'])
        && data.keys().hasOnly(['id', 'userId', 'userEmail', 'breedName', 'vernacularName', 'category', 'scientificName', 'confidence', 'stateOfOrigin', 'homeTract', 'utility', 'nbagrCode', 'notes', 'timestamp']);
    }

    // Project Observation Validation
    function isValidProjectObservation(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.breedName is string && data.breedName.size() <= 128
        && data.fieldNotes is string && data.fieldNotes.size() <= 2000
        && data.timestamp is number
        && data.keys().hasAll(['id', 'userId', 'title', 'breedName', 'fieldNotes', 'timestamp'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'breedName', 'location', 'fieldNotes', 'timestamp']);
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming())
        && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // Collection: /scans/{scanId}
    match /scans/{scanId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(scanId) && isValidScanRecord(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidScanRecord(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Collection: /observations/{observationId}
    match /observations/{observationId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(observationId) && isValidProjectObservation(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidProjectObservation(incoming())
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
